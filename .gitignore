# ==============================================================================
# .gitignore — Condition Monitoring Hydraulic Systems
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Large Datasets (>500 MB)
# Silakan unduh dataset dari UCI ML Repository dan ekstrak ke libraries/dataset/
libraries/dataset/*.txt

# Reference Papers / PDFs
libraries/paper/
*.pdf

# Intermediate Generated Data & Binary Caches (>250 MB)
# File-file ini digenerate ulang otomatis saat menjalankan run_pipeline.py
outputs/data/

# Internal Working Drafts & Notes (Sesuai preferensi pengumpulan repo kode murni)
DRAFT_HASIL.md
REPORT.md
PREPROCESSING_REPORT.md
TASK_STATUS.md

# OS & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
